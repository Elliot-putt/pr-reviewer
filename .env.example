# Copy to .env and fill in — or just run the app and use the Settings page,
# which writes this file for you.

# Slack app (Socket Mode) — see README "Slack app setup"
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXXXX

# GitHub PAT with repo scope
GITHUB_TOKEN=ghp_...

# Folder containing your local clones; <CODE_ROOT>/<repo> is used per PR
CODE_ROOT=/Users/you/code

# Repo whose .claude/skills is used when a PR's repo lacks /code-review
SKILLS_REPO=spectre-websites

# Claude Code
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
REVIEW_COMMAND=/code-review
ADDRESS_COMMAND=/address-comments

# Behaviour
AUTO_REVIEW=true
SESSION_IDLE_MINUTES=20
NATIVE_NOTIFICATIONS=true
